# Codex 安全入口：使用工作区沙箱，并由用户审批越界或高风险动作。
alias cx="codex --sandbox workspace-write --ask-for-approval on-request"

# Codex 全权限入口：仅在明确需要无沙箱、无审批时由用户主动选择。
alias cxyolo="codex --dangerously-bypass-approvals-and-sandbox"

# Claude CLI 的无沙箱快捷命令。
alias ccyolo="claude --dangerously-skip-permissions"

# claude wrapper：默认加 --dangerously-skip-permissions，并**拒绝** /mnt/c 下的 Windows 版
# claude.exe 接管 WSL 仓库（它用 Git Bash 跑 hook → python3 命中商店 stub → qflow 的
# PreToolUse guard 全部 fail-open）。必须放在 nvm 加载之后。2026-08-14 补挂。
[ -s "$HOME/.claude/bin/claude-wrapper.sh" ] && \. "$HOME/.claude/bin/claude-wrapper.sh"
