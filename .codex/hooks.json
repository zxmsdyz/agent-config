{
  "description": "Codex 会话的 tmux 自动命名",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/bin/codex-pane-title.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/bin/codex-pane-title.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
