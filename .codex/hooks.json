{
  "description": "Codex 原生会话名兜底与终态提醒",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/bin/codex-pane-title.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/bin/codex-notify-done.sh",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/bin/codex-notify-done.sh",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
